# Generated by: nexus image minimal
# The least that still works, for machines with little to spare
#
# One package per capability the profile asks for. Their
# dependencies are left to the package manager.
#
# Regenerate with:
#     nexus image minimal --with-available

systemd                         # init
glibc                           # c-library
coreutils                       # core-utilities
dnf5                            # package-manager
openbox                         # lightweight-session
foot                            # terminal-emulator
nano                            # text-editor
dolphin                         # file-manager
