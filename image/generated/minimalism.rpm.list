# Generated by: nexus image base,minimalism
# What any usable system needs regardless of what it is for; A full desktop kept simple: one tool per job, nothing duplicated
#
# One package per capability the profile asks for. Their
# dependencies are left to the package manager.
#
# Regenerate with:
#     nexus image base,minimalism --with-available

systemd                         # init
NetworkManager                  # network-manager
NetworkManager-wifi             # network-manager-wifi
wpa_supplicant                  # wifi-supplicant
glibc                           # c-library
coreutils                       # core-utilities
dnf5                            # package-manager
ca-certificates                 # ca-certificates
tar                             # archiver
plasma-workspace                # desktop-session
sddm                            # display-manager
konsole                         # terminal-emulator
dolphin                         # file-manager
kate                            # text-editor
firefox                         # web-browser
okular                          # document-viewer
gwenview                        # image-viewer
ark                             # archive-manager
plasma-systemsettings           # system-settings
spectacle                       # screenshot-tool
pipewire                        # audio-server
plasma-nm                       # network-applet
plasma-pa                       # volume-applet
xdg-desktop-portal-kde          # desktop-portal
