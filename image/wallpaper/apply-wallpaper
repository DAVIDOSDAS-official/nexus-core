#!/usr/bin/env bash
#
# Put the Nexus wallpaper on this user's desktop, once.
#
# Run at login by /etc/xdg/autostart/nexus-wallpaper.desktop. Which
# wallpaper:
#
#   1. /etc/nexus/wallpaper -- a profile name, written by first boot
#      for the first add-on somebody chose there;
#   2. otherwise the image's own profile (VARIANT_ID in os-release);
#   3. otherwise base, which every image has.
#
# Once per choice, not once per login. What was applied is recorded in
# ~/.config/nexus/wallpaper-applied (Plasma) or wallpaper-applied-lxqt
# (LXQt), and while /etc/nexus/wallpaper still names the same thing
# this does nothing -- so a wallpaper the person picks themselves
# stays. Only a new choice in first boot changes it again.
#
# One record per desktop, because a home folder outlives an edition:
# on the Asus (28 September) the KDE edition's record came along to
# the minimal edition, and LXQt never got a wallpaper -- the record
# said it was done, and it was, on a desktop no longer there. Plasma
# keeps the original file name, so nobody on the KDE edition gets
# their own wallpaper replaced by this update.
#
# Never fails a login: every problem ends in exit 0.

set -u

STATE_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/nexus"
WALLPAPERS=/usr/share/wallpapers

wanted=""

if [ -r /etc/nexus/wallpaper ]; then
    # A name, and only a name: it becomes part of a path.
    wanted="$(head -n 1 /etc/nexus/wallpaper | tr -cd 'a-z0-9-')"
fi

if [ -z "${wanted}" ] && [ -r /etc/os-release ]; then
    wanted="$(. /etc/os-release && printf '%s' "${VARIANT_ID:-}" \
        | tr -cd 'a-z0-9-')"
fi

if [ -z "${wanted}" ] || [ ! -d "${WALLPAPERS}/nexus-${wanted}" ]; then
    wanted=base
fi

package="${WALLPAPERS}/nexus-${wanted}"

if [ ! -d "${package}" ]; then
    exit 0
fi

# Plasma (the KDE edition) or LXQt's desktop, pcmanfm-qt (the minimal
# edition). Anything else: leave the wallpaper alone.
if command -v plasma-apply-wallpaperimage > /dev/null 2>&1; then
    apply() { plasma-apply-wallpaperimage "$1"; }
    STATE="${STATE_DIR}/wallpaper-applied"
elif command -v pcmanfm-qt > /dev/null 2>&1; then
    apply() { pcmanfm-qt --set-wallpaper="$1" --wallpaper-mode=zoom; }
    STATE="${STATE_DIR}/wallpaper-applied-lxqt"
else
    exit 0
fi

if [ "$(cat "${STATE}" 2>/dev/null)" = "${wanted}" ]; then
    exit 0
fi

image=""
for candidate in "${package}"/contents/images/*.jpg; do
    [ -f "${candidate}" ] && image="${candidate}" && break
done

if [ -z "${image}" ]; then
    exit 0
fi

# The desktop may not be up yet when autostart runs this, and both
# setters fail until it is. So it is retried for
# a minute, and nothing is recorded unless it worked -- a wallpaper
# that failed to apply is tried again at the next login rather than
# marked done.
for _ in $(seq 1 30); do
    if apply "${image}" > /dev/null 2>&1; then
        mkdir -p "$(dirname "${STATE}")"
        printf '%s\n' "${wanted}" > "${STATE}"
        exit 0
    fi
    sleep 2
done

exit 0
