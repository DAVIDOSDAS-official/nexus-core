# Generated by: nexus image showcase
# Everything on display: effects, themes and polish, still safe to use
#
# One package per capability the profile asks for. Their
# dependencies are left to the package manager.
#
# Regenerate with:
#     nexus image showcase --with-available

plasma-workspace                # desktop-session
sddm                            # display-manager
kwin                            # compositor-effects
breeze-icon-theme               # icon-theme
breeze-cursor-theme             # cursor-theme
google-noto-fonts-common        # font-collection
foot                            # terminal-emulator
dolphin                         # file-manager
kate                            # text-editor
firefox                         # web-browser
gwenview                        # image-viewer
pipewire                        # audio-server
# UNRESOLVED: gpu-vendor-amd | gpu-vendor-intel | gpu-vendor-nvidia
