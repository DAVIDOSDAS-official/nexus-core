# Generated by: nexus image base,minimal
# What any usable system needs regardless of what it is for; A light, complete desktop for older computers: LXQt, and nothing it does not need
#
# One package per capability the profile asks for. Their
# dependencies are left to the package manager.
#
# Written out by hand on 27 September from the profile's own Prefers
# lines, because the generator needs Fedora's repositories and was not
# run here. Every name was then checked against Fedora 44's repositories
# (dnf repoquery, run by David on the Acer). The weekly build installs
# exactly this list; a name Fedora drops fails the build loudly.
#
# Regenerate with:
#     nexus image base,minimal --with-available

systemd                         # init
NetworkManager                  # network-manager
NetworkManager-wifi             # network-manager-wifi
wpa_supplicant                  # wifi-supplicant
glibc                           # c-library
coreutils                       # core-utilities
dnf5                            # package-manager
ca-certificates                 # ca-certificates
tar                             # archiver
lxqt-labwc-session              # desktop-session
lxqt-session                    # session-manager
lxqt-globalkeys                 # global-shortcuts
lxqt-qtplugin                   # qt-desktop-integration
lxqt-themes                     # desktop-theme
labwc                           # window-manager
sddm                            # display-manager
sddm-wayland-miriway            # greeter-compositor
lxqt-panel                      # desktop-panel
lxqt-runner                     # application-launcher
lxqt-policykit                  # polkit-agent
lxqt-notificationd              # notification-daemon
lxqt-powermanagement            # power-manager
qterminal                       # terminal-emulator
pcmanfm-qt                      # file-manager
featherpad                      # text-editor
firefox                         # web-browser
qpdfview                        # document-viewer
lximage-qt                      # image-viewer
lxqt-archiver                   # archive-manager
lxqt-config                     # system-settings
screengrab                      # screenshot-tool
pipewire                        # audio-server
pipewire-pulseaudio             # pulseaudio-compat
network-manager-applet          # network-applet
pavucontrol-qt                  # volume-applet
xdg-desktop-portal-lxqt         # desktop-portal
breeze-icon-theme               # icon-theme
breeze-cursor-theme             # cursor-theme
lxqt-menu-data                  # application-menu-data
upower                          # battery-status
gvfs                            # virtual-filesystem
xdg-user-dirs                   # user-folders
lxqt-sudo                       # admin-prompt
nm-connection-editor            # network-settings
sddm-themes                     # login-themes
