#!/usr/bin/env bash
#
# The first thing a new machine does.
#
# This is a thin wrapper: it asks, and nexus decides. Every question
# it can answer is answered by asking nexus rather than by knowing
# anything itself -- which profiles exist, what they cost here, what
# hardware is present. A second place that knows those things would
# eventually disagree with the first.
#
# It runs once. The marker is written whatever happens, including when
# somebody declines, because a setup that asks again every boot is
# worse than one that never asked.

set -uo pipefail

MARKER="${NEXUS_SETUP_MARKER:-/var/lib/nexus/setup-complete}"
NEXUS="${NEXUS_BINARY:-/usr/bin/nexus}"

if [ -e "${MARKER}" ]; then
    exit 0
fi

if [ ! -x "${NEXUS}" ]; then
    echo "nexus is not installed at ${NEXUS}; skipping setup." >&2
    exit 0
fi

# Only when the question was actually put.
#
# The marker used to be written on any exit, so a run that failed for
# want of a terminal disabled the picker permanently -- and the
# machine never asked again. A setup that could not ask has not
# finished.
ASKED=0

# Hold the screen until somebody has read it.
#
# Whatever this script prints, the display manager takes the console
# the moment it exits. On 23 September a laptop booted with no network:
# the offline explanation -- how to connect, what to run -- was printed
# and replaced by the login screen in the same instant, and from the
# chair it looked as though first boot had never run at all. The VM
# never showed this, because a VM is always online.
#
# So every exit waits for Enter, on a terminal only (with none there is
# nobody to wait for), and not forever: an unattended machine still
# reaches its login screen, five minutes later.
SHOWN=0

pause_before_leaving() {
    if [ "${SHOWN}" != "1" ] || [ ! -t 0 ]; then
        return
    fi

    echo
    printf "  Press Enter to continue to the login screen. "

    # Same reason as before the question: keys pressed while the text
    # was scrolling past would otherwise count as the Enter.
    while read -r -s -t 0.05 -n 1 _ 2>/dev/null; do :; done

    read -r -t 300 _ 2>/dev/null || true
    echo
}

finish() {
    restore_printk
    pause_before_leaving

    if [ "${ASKED}" != "1" ]; then
        return
    fi

    mkdir -p "$(dirname "${MARKER}")" 2>/dev/null
    date -u +%Y-%m-%dT%H:%M:%SZ > "${MARKER}" 2>/dev/null
}

# Written even on interruption: a half-finished setup that asks again
# on every boot is worse than one that stopped.
trap finish EXIT

# The kernel logs to the same console. Without this a message lands
# on top of the prompt while somebody is typing into it, and the line
# they submit is not the line they wrote.
QUIET_APPLIED=0

if [ -w /proc/sys/kernel/printk ]; then
    PRINTK_WAS="$(cat /proc/sys/kernel/printk 2>/dev/null)"
    echo 1 > /proc/sys/kernel/printk 2>/dev/null && QUIET_APPLIED=1
fi

restore_printk() {
    if [ "${QUIET_APPLIED}" = "1" ] && [ -n "${PRINTK_WAS:-}" ]; then
        echo "${PRINTK_WAS}" > /proc/sys/kernel/printk 2>/dev/null
    fi
}

# Nothing to ask into.
#
# systemd is told to give this a terminal, and it does -- but the
# display manager takes the same console, and a prompt printed into a
# console somebody else owns is a prompt nobody sees. Finding that out
# here costs nothing; finding it out after the scan costs a quarter of
# a gigabyte and a marker that says this machine was asked.
# English (US) as a second keyboard layout, whatever the first is.
#
# Somebody who installs in Bosnian gets a Bosnian keyboard -- Y and Z
# swapped, symbols elsewhere -- and on 26 September that left a person
# unable to type commands, with no way back to a US layout short of
# finding the setting in a language they had only chosen for testing.
# With two layouts the desktop shows which is active and switches with
# Super+Space (and KDE's own Meta+Alt+K).
#
# Only the desktop's layouts change. --no-convert leaves the console
# keymap alone, and that is the one the disk passphrase is typed on:
# changing it would change what the passphrase has to be typed as.
# Remove the second layout in System Settings -> Keyboard if unwanted.
add_english_layout() {
    command -v localectl > /dev/null 2>&1 || return 0

    local status layouts model variants options
    status="$(LC_ALL=C.UTF-8 localectl status 2>/dev/null)" || return 0
    layouts="$(printf '%s\n' "${status}" | sed -n 's/^ *X11 Layout: *//p')"
    model="$(printf '%s\n' "${status}" | sed -n 's/^ *X11 Model: *//p')"
    variants="$(printf '%s\n' "${status}" | sed -n 's/^ *X11 Variant: *//p')"
    options="$(printf '%s\n' "${status}" | sed -n 's/^ *X11 Options: *//p')"

    case ",${layouts}," in
        ,,|*,us,*) return 0 ;;
    esac

    # One variant per layout, so the new one needs an empty slot.
    local count
    count="$(printf '%s' "${layouts}" | tr -cd ',' | wc -c)"
    while [ "$(printf '%s' "${variants}" | tr -cd ',' | wc -c)" -lt "${count}" ]; do
        variants="${variants},"
    done

    local switch="Super+Space"
    case ",${options}," in
        *,grp:*) switch="your existing layout shortcut, or Meta+Alt+K" ;;
        ,,) options="grp:win_space_toggle" ;;
        *) options="${options},grp:win_space_toggle" ;;
    esac

    if localectl --no-convert set-x11-keymap "${layouts},us" \
            "${model}" "${variants}," "${options}" 2>/dev/null; then
        echo "Keyboard: added English (US) alongside ${layouts}." \
            "Switch with ${switch}."
    fi
}

add_english_layout

if [ ! -t 0 ]; then
    echo "nexus-first-boot has no terminal to ask on; not asking." >&2
    echo "The machine is usable. Run 'nexus setup' to choose." >&2
    exit 1
fi

clear 2>/dev/null

# From here on something is on the screen worth reading before it
# goes; see pause_before_leaving.
SHOWN=1

cat <<'BANNER'

  Nexus

  This machine has not been set up yet. Nexus will show you what it
  can be, and what each choice would cost here.

  Nothing is installed until you say so.

BANNER

# --with-available matters: without the archive nothing is available,
# every missing requirement reports that nothing provides it, and the
# machine looks unimprovable rather than unconfigured.
# Nothing can be installed without a repository to install from, and
# offering twelve profiles that all fail is worse than saying so.
online() {
    if command -v nm-online > /dev/null 2>&1; then
        nm-online -q -t 20 && return 0
    fi

    for host in 1.1.1.1 8.8.8.8; do
        if ping -c1 -W3 "${host}" > /dev/null 2>&1; then
            return 0
        fi
    done

    return 1
}

# A policy module with no files, left by the container build.
#
# semodule cannot read past it -- not to rebuild the policy, not even
# to list modules -- so finalizing any new deployment fails and the
# deployment is discarded. rpm-ostree cannot layer a package until it
# is gone.
#
# Here rather than in the Containerfile because overlayfs refuses to
# delete it during a build ("Input/output error") and a real
# filesystem does not.
if [ -d /etc/selinux/targeted/active/modules/400/extra_varrun ] && \
   [ -z "$(ls -A /etc/selinux/targeted/active/modules/400/extra_varrun \
        2>/dev/null)" ]; then
    rm -rf /etc/selinux/targeted/active/modules/400/extra_varrun \
        2>/dev/null || true
fi

echo "  Checking for a network."
echo

if ! online; then
    cat <<'OFFLINE'
  This machine is not online, so there is nothing to install from.

  The quickest way, and the one that works even when wifi does not:

      Plug your phone in with a USB cable and turn on USB tethering
      in its settings. It appears here as a wired connection --
      no driver, no password, nothing to configure.

        Android   Settings -> Network -> Hotspot & tethering
                  -> USB tethering
        iPhone    Settings -> Personal Hotspot, then trust this
                  computer when asked

  Or, over wifi:

      a desktop      click the network icon and pick your network
      a console      nmcli device wifi list
                     sudo nmcli --ask device wifi connect "NAME"

  Then run:

      nexus setup

  Nothing has been changed, and this will ask again next time.

OFFLINE
    exit 0
fi

# Fetch the package lists before asking.
#
# /var/cache/libdnf5 is empty on a machine that has just been
# installed -- the image ships the tool, not a copy of Fedora's
# index. Without it nexus reads nothing, every requirement in every
# profile reports that nothing provides it, and the picker offers
# twelve choices that all look impossible. The machine looks broken
# when it is merely unconfigured.
#
# Checked rather than always run: a second boot that reaches this
# point already has the cache, and refetching it costs a minute for
# nothing.
#
# The shape of the check is the same one nexus uses -- a repository
# directory with a repodata/repomd.xml inside it. Asking the same
# question a different way is how two places come to disagree.
have_metadata() {
    local repomd

    for repomd in /var/cache/libdnf5/*/repodata/repomd.xml; do
        [ -f "${repomd}" ] && return 0
    done

    return 1
}

if ! have_metadata; then
    echo "  Fetching the package lists. This takes a moment."
    echo

    # No pipe into tail here on purpose. `set -o pipefail` is on, so a
    # pipeline would report dnf's failure correctly -- but somebody
    # reading this later should not have to know that to believe it,
    # and five minutes of nothing on screen looks like a hang.
    if ! timeout 300 dnf makecache; then
        echo
        echo "  The package lists could not be fetched, so Nexus cannot"
        echo "  see what is available yet. This is a network or mirror"
        echo "  problem, not a broken machine."
        echo
        echo "  When the network is working:"
        echo
        echo "      sudo dnf makecache"
        echo "      nexus setup"
        echo
        echo "  Nothing has been changed, and this will ask again next"
        echo "  time."
        echo
        exit 0
    fi

    # Fetching can report success and still leave nothing readable.
    # The claim being made here is that nexus can see packages, so
    # that is the thing to check, rather than dnf's exit status.
    if ! have_metadata; then
        echo
        echo "  dnf reported success but left no readable metadata in"
        echo "  /var/cache/libdnf5. Nexus cannot see what is available,"
        echo "  so it will not pretend to offer it."
        echo
        echo "  Run 'nexus setup' once 'sudo dnf makecache' works."
        echo
        exit 0
    fi

    echo
fi

"${NEXUS}" setup --with-available || true

echo
echo "  Type one or more names separated by commas, or press Enter"
echo "  twice to skip. You can run 'nexus setup' again at any time."
echo
# Keys pressed during boot wait in the console's buffer and are read
# as though they were typed here. Somebody who pressed Enter at the
# passphrase prompt had already "answered" before seeing the question,
# and the picker skipped itself. Anything waiting is discarded.
while read -r -s -t 0.05 -n 1 _ 2>/dev/null; do :; done

printf "  > "

# A failed read is not somebody pressing Enter.
#
# These are the same empty string and mean opposite things: one is a
# person declining, the other is a console that went away underneath.
# Treated alike, the second wrote the marker and the picker never ran
# again on that machine.
if ! read -r CHOICE; then
    echo >&2
    echo "The console went away before this was answered." >&2
    echo "Nothing has been changed. Run 'nexus setup' to choose." >&2
    exit 1
fi

ASKED=1

CHOICE="$(echo "${CHOICE}" | tr -d '[:space:]')"

# One empty line is not a decision.
#
# It is what a stray keypress looks like, and a skip cannot be undone
# from here. So it is asked again, and a second empty answer is taken
# at its word: the machine is theirs, and so is the choice not to set
# it up.
if [ -z "${CHOICE}" ]; then
    echo
    echo "  Nothing was typed. Press Enter again to skip setup, or type"
    echo "  the names now."
    echo
    printf "  > "

    if ! read -r CHOICE; then
        ASKED=0
        echo >&2
        echo "The console went away before this was answered." >&2
        echo "Nothing has been changed. Run 'nexus setup' to choose." >&2
        exit 1
    fi

    CHOICE="$(echo "${CHOICE}" | tr -d '[:space:]')"
fi

if [ -z "${CHOICE}" ]; then
    echo
    echo "  Nothing has been changed. Run 'nexus setup' when you are"
    echo "  ready."
    echo
    exit 0
fi

echo
"${NEXUS}" setup "${CHOICE}" --with-available --apply --yes
STATUS=$?

# The wallpaper follows the choice: the first add-on named that has
# one. Written whatever the setup's result -- it records what was
# chosen, and a partly failed install is still that choice. Applied at
# the next login by /usr/libexec/nexus/apply-wallpaper; see there.
#
# Only names that are wallpapers get this far, and a name is all that
# is written: it becomes part of a path.
for name in ${CHOICE//,/ }; do
    name="$(printf '%s' "${name}" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9-')"

    if [ -n "${name}" ] && [ -d "/usr/share/wallpapers/nexus-${name}" ]; then
        mkdir -p /etc/nexus
        printf '%s\n' "${name}" > /etc/nexus/wallpaper
        break
    fi
done

echo

if [ "${STATUS}" -eq 0 ]; then
    echo "  Done. 'nexus doctor' will tell you how the machine is."
else
    # Partial success is still success for the parts that worked.
    echo "  Some things did not install. The system is usable; run"
    echo "  'nexus setup ${CHOICE}' to try the rest."
fi

echo

exit 0
